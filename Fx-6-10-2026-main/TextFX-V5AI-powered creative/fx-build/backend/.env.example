# ── TextFX Backend — Environment Variables ────────────────────────────────────
# Copy to .env and fill secrets locally. Do NOT commit .env.

# ── Server ────────────────────────────────────────────────────────────────────
PORT=4002
NODE_ENV=development

# ── CORS: comma-separated list of allowed origins (required in production) ────
# Example: https://textfx.yourdomain.com,https://app.textfx.com
# Leave empty in development to allow all origins.
ALLOWED_ORIGINS=

# ── AI Provider priority ──────────────────────────────────────────────────────
# Priority: Gemini → OpenRouter → OpenAI → VertexAI → Mock
# Gemini is the primary/premium provider when GEMINI_API_KEY is configured.
GEMINI_API_KEY=REPLACE_ME_GEMINI_API_KEY
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TEMPERATURE=0.8
GEMINI_MAX_OUTPUT_TOKENS=2000

# OpenRouter — second priority; OpenAI-compatible API supporting multiple models
OPENROUTER_API_KEY=REPLACE_ME_OPENROUTER_API_KEY
OPENROUTER_MODEL=anthropic/claude-3.5-sonnet

# OR OpenAI
# OPENAI_API_KEY=REPLACE_ME_OPENAI_API_KEY
# OPENAI_MODEL=gpt-4o-mini

# OR Google Vertex AI
# GOOGLE_CLOUD_PROJECT=REPLACE_ME_GCP_PROJECT_ID
# VERTEX_MODEL=gemini-1.5-pro

# ── Live Trends (optional) ────────────────────────────────────────────────────
# SERPAPI_KEY=REPLACE_ME_SERPAPI_KEY
# TRENDS_REGION=EG

# ── Governance Loop ───────────────────────────────────────────────────────────
# AUDIT_THRESHOLD=0.7
# MAX_RETRIES=2
